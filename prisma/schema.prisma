// Economan 2 — Commandes par département
// Toutes les clés primaires sont des entiers auto-incrémentés (serial).
// Les index sont posés sur tous les chemins de lecture chauds.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  color     String   @default("#38bdf8")
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories DepartmentCategory[]
  products   DepartmentProduct[]
  users      User[]
  orders     Order[]
  stockFixe  StockFixe[]

  @@index([isActive, sortOrder])
  @@map("departments")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
  departments DepartmentCategory[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

/// Affectation : quelles catégories (donc quels articles) un département peut commander.
model DepartmentCategory {
  departmentId Int
  categoryId   Int
  sortOrder    Int @default(0)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([departmentId, categoryId])
  @@index([categoryId])
  @@index([departmentId, sortOrder])
  @@map("department_categories")
}

model Unit {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  symbol         String   @unique
  allowsDecimals Boolean  @default(true)
  createdAt      DateTime @default(now())

  products   Product[]
  orderLines OrderLine[]

  @@map("units")
}

model Product {
  id          Int      @id @default(autoincrement())
  reference   String   @unique
  name        String
  description String?
  imageUrl    String?
  categoryId  Int
  baseUnitId  Int
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  baseUnit  Unit        @relation(fields: [baseUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines       OrderLine[]
  stockFixe   StockFixe[]
  departments DepartmentProduct[]

  // Chemin chaud : « tous les articles actifs d'une catégorie, triés ».
  @@index([categoryId, isActive, sortOrder])
  @@index([isActive])
  @@index([name])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────
// Utilisateurs
// ─────────────────────────────────────────────────────────────

enum Role {
  EMPLOYEE
  ECONOMAN
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  fullName     String
  passwordHash String
  role         Role     @default(EMPLOYEE)
  departmentId Int?
  avatarColor  String   @default("#38bdf8")
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  credentials Credential[]

  ordersCreated   Order[] @relation("OrderCreatedBy")
  ordersProcessed Order[] @relation("OrderProcessedBy")
  ordersReceived  Order[] @relation("OrderReceivedBy")
  refillsCreated  OrderRefill[] @relation("RefillCreatedBy")

  @@index([departmentId, isActive])
  @@index([role, isActive])
  @@map("users")
}

/// Empreinte digitale / passkey (WebAuthn). Un utilisateur peut enrôler plusieurs appareils.
model Credential {
  id             Int      @id @default(autoincrement())
  userId         Int
  credentialId   String   @unique
  publicKey      Bytes
  counter        BigInt   @default(0)
  transports     String?
  deviceLabel    String?
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("credentials")
}

/// Challenge WebAuthn éphémère (inscription et authentification).
model WebAuthnChallenge {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  challenge String
  userId    Int?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

// ─────────────────────────────────────────────────────────────
// Commandes
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING    // envoyée par l'employé, en attente chez l'économat
  ACCEPTED   // ouverte / en cours de traitement par l'économat
  DELIVERED  // bon de livraison émis, en route
  RECEIVED   // l'employé a confirmé la réception — dossier clos
  CANCELLED
}

enum LineStatus {
  PENDING
  VALIDATED  // servi tel que demandé
  ADJUSTED   // servi en quantité différente
  REJECTED   // rupture
}

model Order {
  id           Int         @id @default(autoincrement())
  reference    String      @unique
  ticketNumber Int
  businessDay  DateTime    @db.Date
  departmentId Int
  createdById  Int
  processedById Int?
  // Qui a confirmé la réception : n'importe quel employé du service peut le
  // faire, et l'auteur de la commande n'est pas toujours celui qui réceptionne.
  receivedById Int?
  status       OrderStatus @default(PENDING)
  note         String?
  createdAt    DateTime    @default(now())
  acceptedAt   DateTime?
  deliveredAt  DateTime?
  receivedAt   DateTime?
  updatedAt    DateTime    @updatedAt

  department  Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   User       @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  processedBy User?      @relation("OrderProcessedBy", fields: [processedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  receivedBy  User?      @relation("OrderReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lines       OrderLine[]
  refills     OrderRefill[]

  // Un seul numéro de ticket par jour et par département.
  @@unique([businessDay, departmentId, ticketNumber])
  // Dashboard admin/économat : « toutes les commandes du jour, groupées par département ».
  @@index([businessDay, departmentId, ticketNumber])
  @@index([status, businessDay])
  // « Mes commandes des 3 derniers jours ».
  @@index([createdById, createdAt])
  @@index([departmentId, createdAt])
  @@map("orders")
}

/// Un passage de service complémentaire : la marchandise manquante arrive
/// après coup, l'économat complète, et chaque passage produit son propre bon.
/// Le premier service reste porté par `OrderLine.quantityServed` ; ceux-ci
/// s'y ajoutent sans le réécrire, pour que l'historique soit lisible.
model OrderRefill {
  id        Int      @id @default(autoincrement())
  orderId   Int
  /// 2 pour le deuxième service, 3 pour le troisième, etc.
  rank      Int
  createdAt DateTime @default(now())
  createdById Int?

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User?     @relation("RefillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lines     OrderRefillLine[]

  @@unique([orderId, rank])
  @@index([orderId])
  @@map("order_refills")
}

/// Ce qui est sorti pour une ligne lors d'un passage complémentaire.
model OrderRefillLine {
  id          Int     @id @default(autoincrement())
  refillId    Int
  orderLineId Int
  quantity    Decimal @db.Decimal(14, 3)

  refill    OrderRefill @relation(fields: [refillId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderLine OrderLine   @relation(fields: [orderLineId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Une ligne d'article par passage.
  @@unique([refillId, orderLineId])
  @@index([orderLineId])
  @@map("order_refill_lines")
}

model OrderLine {
  id              Int        @id @default(autoincrement())
  orderId         Int
  productId       Int
  unitId          Int
  productName     String     // figé à la commande, pour que le bon reste lisible
  productRef      String
  categoryName    String
  // Figés au moment de l'envoi : le stock fixe et le stock compté qui ont
  // produit la quantité. Un réglage ultérieur du stock fixe ne doit pas
  // réécrire l'histoire d'une commande déjà passée.
  stockFixe       Decimal    @default(0) @db.Decimal(14, 3)
  quantityOnHand  Decimal    @default(0) @db.Decimal(14, 3)
  quantityAsked   Decimal    @db.Decimal(14, 3)
  quantityServed  Decimal?   @db.Decimal(14, 3)
  /// Ce que l'employé a réellement compté à la réception. Nul tant qu'il n'a
  /// pas vérifié ; un écart avec quantityServed est conservé comme trace.
  quantityReceived Decimal?  @db.Decimal(14, 3)
  status          LineStatus @default(PENDING)
  rejectReason    String?
  sortOrder       Int        @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refills OrderRefillLine[]

  // Une ligne par article et par commande.
  @@unique([orderId, productId])
  @@index([orderId, sortOrder])
  @@index([productId])
  @@map("order_lines")
}

/// Affectation article par article.
///
/// Certaines feuilles de service ne suivent pas les catégories : la pâtisserie
/// commande le sucre glace mais pas les spaghettis, alors que les deux vivent
/// dans la même catégorie. Dès qu'un département possède au moins une ligne
/// ici, cette liste **remplace** ses catégories : sa feuille vaut exactement
/// ces articles, ni plus ni moins.
model DepartmentProduct {
  departmentId Int
  productId    Int
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([departmentId, productId])
  @@index([productId])
  @@index([departmentId, sortOrder])
  @@map("department_products")
}

/// Stock fixe : la quantité qu'un département doit détenir pour un article.
/// Réglée par l'administration ; c'est la cible dont on soustrait le stock
/// compté par l'employé pour obtenir la quantité à commander.
model StockFixe {
  departmentId Int
  productId    Int
  quantity     Decimal  @db.Decimal(14, 3)
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([departmentId, productId])
  @@index([productId])
  @@map("stock_fixe")
}

/// Compteur de tickets, un par jour et par département. Incrémenté atomiquement.
model TicketCounter {
  businessDay  DateTime @db.Date
  departmentId Int
  lastNumber   Int      @default(0)

  @@id([businessDay, departmentId])
  @@map("ticket_counters")
}
