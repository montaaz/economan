# Copier en `.env` et renseigner les valeurs de votre installation.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Signe les cookies de session. OBLIGATOIRE : générer une valeur unique avec
#   openssl rand -base64 32
# Ne jamais réutiliser la valeur d'un exemple en production.
AUTH_SECRET=
AUTH_TRUST_HOST=true

BUSINESS_TIMEZONE=Africa/Tunis

# WebAuthn (connexion par empreinte digitale).
# Exige un contexte sécurisé : localhost en développement, HTTPS en production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Economan
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Production ---------------------------------------------------------
# L'adresse à laquelle le serveur relit ses propres pages pour fabriquer les
# PDF (bons, feuilles). Par défaut http://127.0.0.1:PORT ; à régler seulement
# si l'application n'écoute pas sur la machine elle-même.
# APP_ORIGIN=http://127.0.0.1:3000

# Le cookie de session exige HTTPS en production. Sur un serveur interne servi
# en HTTP simple, mettre 0 — sinon la connexion échoue sans message.
# SESSION_COOKIE_SECURE=0

# Taille du pool de connexions Postgres (20 par défaut sur un serveur).
# DATABASE_POOL_MAX=20

# Heure de clôture de la journée de service (0-23).
# SERVICE_CLOSING_HOUR=3

# NEXT_PUBLIC_DEV_LOGIN=1 préremplit les écrans de connexion en développement.
# Ignoré en production, quoi qu'il arrive.

# Base source pour `npm run db:import` (reprise du catalogue). Facultatif.
# SOURCE_DATABASE_URL=postgresql://user:password@localhost:5432/economan

# Dossier des photos de factures (par défaut ./storage). À sauvegarder avec la base.
# STORAGE_DIR=/var/lib/economan/storage
