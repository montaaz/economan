// Economan 2 — Commandes par département
// Toutes les clés primaires sont des entiers auto-incrémentés (serial).
// Les index sont posés sur tous les chemins de lecture chauds.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  color     String   @default("#38bdf8")
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories DepartmentCategory[]
  products   DepartmentProduct[]
  users      User[]
  orders     Order[]
  stockFixe  StockFixe[]
  salesItems SalesItem[]

  @@index([isActive, sortOrder])
  recipes      Recipe[]
  @@map("departments")
  declaredSales DeclaredSale[]
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
  departments DepartmentCategory[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

/// Affectation : quelles catégories (donc quels articles) un département peut commander.
model DepartmentCategory {
  departmentId Int
  categoryId   Int
  sortOrder    Int @default(0)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([departmentId, categoryId])
  @@index([categoryId])
  @@index([departmentId, sortOrder])
  @@map("department_categories")
}

model Unit {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  symbol         String   @unique
  allowsDecimals Boolean  @default(true)
  createdAt      DateTime @default(now())

  products   Product[]
  orderLines OrderLine[]

  @@map("units")
}

model Product {
  id          Int      @id @default(autoincrement())
  reference   String   @unique
  name        String
  description String?
  imageUrl    String?
  categoryId  Int
  baseUnitId  Int
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Dispatching : un article servi à la portion vient d'un article mère
  // acheté en gros (100 kg d'escalope → des escalopes pizza). `motherQuantity`
  // dit ce qu'une portion consomme de la mère, dans l'unité de la mère
  // (0,300 kg) ; le stock général, lui, ne compte que la mère.
  kind           ProductKind @default(FINI)
  parentId       Int?
  motherQuantity Decimal? @db.Decimal(14, 4)
  parent       Product?  @relation("Portions", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  portions     Product[] @relation("Portions")
  stockEntries StockEntry[]

  category  Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  baseUnit  Unit        @relation(fields: [baseUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines       OrderLine[]
  stockFixe   StockFixe[]
  departments DepartmentProduct[]

  // Chemin chaud : « tous les articles actifs d'une catégorie, triés ».
  @@index([categoryId, isActive, sortOrder])
  @@index([isActive])
  @@index([name])
  // Le dispatching : les portions d'une mère, les articles d'une nature.
  @@index([parentId])
  @@index([kind])
  recipeLines  RecipeLine[]
  @@map("products")
  declaredSales DeclaredSale[]
}

// ─────────────────────────────────────────────────────────────
// Utilisateurs
// ─────────────────────────────────────────────────────────────

enum Role {
  EMPLOYEE
  ECONOMAN
  /// Contrôle de gestion : saisit le Z de la veille et consulte les stocks
  /// de tous les départements. Ne commande ni ne sert.
  CONTROLEUR
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  fullName     String
  passwordHash String
  role         Role     @default(EMPLOYEE)
  departmentId Int?
  avatarColor  String   @default("#38bdf8")
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  credentials Credential[]

  ordersCreated   Order[] @relation("OrderCreatedBy")
  ordersProcessed Order[] @relation("OrderProcessedBy")
  ordersReceived  Order[] @relation("OrderReceivedBy")
  refillsCreated  OrderRefill[] @relation("RefillCreatedBy")
  refillsReceived OrderRefill[] @relation("RefillReceivedBy")
  salesReports    SalesReport[] @relation("SalesReportCreatedBy")
  stockEntries StockEntry[] @relation("StockEntryCreatedBy")

  @@index([departmentId, isActive])
  @@index([role, isActive])
  @@map("users")
  declaredSales DeclaredSale[] @relation("DeclaredSaleCreatedBy")
}

/// Empreinte digitale / passkey (WebAuthn). Un utilisateur peut enrôler plusieurs appareils.
model Credential {
  id             Int      @id @default(autoincrement())
  userId         Int
  credentialId   String   @unique
  publicKey      Bytes
  counter        BigInt   @default(0)
  transports     String?
  deviceLabel    String?
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("credentials")
}

/// Challenge WebAuthn éphémère (inscription et authentification).
model WebAuthnChallenge {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  challenge String
  userId    Int?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

// ─────────────────────────────────────────────────────────────
// Commandes
// ─────────────────────────────────────────────────────────────

/// La nature d'un article au stock général : fini (acheté tel qu'on le sert),
/// mère (acheté en gros, dispatché en articles préparés), préparé (une portion
/// d'une mère : ne s'achète pas, ne se stocke pas à part).
enum ProductKind {
  FINI
  MERE
  PREPARE
}

enum OrderStatus {
  PENDING    // envoyée par l'employé, en attente chez l'économat
  ACCEPTED   // ouverte / en cours de traitement par l'économat
  DELIVERED  // bon de livraison émis, en route
  RECEIVED   // l'employé a confirmé la réception — dossier clos
  CANCELLED
}

enum LineStatus {
  PENDING
  VALIDATED  // servi tel que demandé
  ADJUSTED   // servi en quantité différente
  REJECTED   // rupture
}

model Order {
  id           Int         @id @default(autoincrement())
  reference    String      @unique
  ticketNumber Int
  businessDay  DateTime    @db.Date
  departmentId Int
  createdById  Int
  processedById Int?
  // Qui a confirmé la réception : n'importe quel employé du service peut le
  // faire, et l'auteur de la commande n'est pas toujours celui qui réceptionne.
  receivedById Int?
  status       OrderStatus @default(PENDING)
  note         String?
  // Passée par l'administration, hors du rythme des feuilles : elle se
  // signale partout en bordeaux, et se traite avant les autres.
  isUrgent     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  acceptedAt   DateTime?
  deliveredAt  DateTime?
  receivedAt   DateTime?
  /// Remarque laissée par le département en confirmant la réception : ce
  /// qui n'allait pas, en une phrase, sans compter ligne par ligne.
  receptionNote String?
  updatedAt    DateTime    @updatedAt

  department  Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   User       @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  processedBy User?      @relation("OrderProcessedBy", fields: [processedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  receivedBy  User?      @relation("OrderReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lines       OrderLine[]
  refills     OrderRefill[]

  // Un seul numéro de ticket par jour et par département.
  @@unique([businessDay, departmentId, ticketNumber])
  // Dashboard admin/économat : « toutes les commandes du jour, groupées par département ».
  @@index([businessDay, departmentId, ticketNumber])
  @@index([status, businessDay])
  // « Mes commandes des 3 derniers jours ».
  @@index([createdById, createdAt])
  @@index([departmentId, createdAt])
  // Le journal du stock et l'argent lisent « les bons émis » : sans index,
  // chaque page rebalayait toutes les commandes.
  @@index([deliveredAt])
  @@map("orders")
}

/// Un passage de service complémentaire : la marchandise manquante arrive
/// après coup, l'économat complète, et chaque passage produit son propre bon.
/// Le premier service reste porté par `OrderLine.quantityServed` ; ceux-ci
/// s'y ajoutent sans le réécrire, pour que l'historique soit lisible.
model OrderRefill {
  id        Int      @id @default(autoincrement())
  orderId   Int
  /// 2 pour le deuxième service, 3 pour le troisième, etc.
  rank      Int
  createdAt DateTime @default(now())
  createdById Int?
  /// Réception du passage, indépendante de celle de la commande : la marchandise
  /// arrive plus tard, et la commande d'origine a pu être reçue depuis longtemps.
  /// Une fois ce champ posé, le passage ne peut plus être supprimé.
  receivedAt   DateTime?
  receivedById Int?
  /// Remarque du département à la réception de ce passage.
  receptionNote String?
  /// Quand le bon de livraison de ce passage a été émis.
  ///
  /// Le papier circule dès cet instant : le passage se fige, sa colonne
  /// devient lecture seule et ne se supprime plus. Nul tant que le servi
  /// n'a été qu'enregistré.
  deliveredAt   DateTime?

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User?     @relation("RefillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  receivedBy User?    @relation("RefillReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lines     OrderRefillLine[]

  @@unique([orderId, rank])
  @@index([orderId])
  @@index([deliveredAt])
  @@index([receivedAt])
  @@map("order_refills")
}

/// Ce qui est sorti pour une ligne lors d'un passage complémentaire.
model OrderRefillLine {
  id          Int     @id @default(autoincrement())
  refillId    Int
  orderLineId Int
  quantity    Decimal @db.Decimal(14, 3)

  refill    OrderRefill @relation(fields: [refillId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderLine OrderLine   @relation(fields: [orderLineId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Une ligne d'article par passage.
  @@unique([refillId, orderLineId])
  @@index([orderLineId])
  @@map("order_refill_lines")
}

model OrderLine {
  id              Int        @id @default(autoincrement())
  orderId         Int
  productId       Int
  unitId          Int
  productName     String     // figé à la commande, pour que le bon reste lisible
  productRef      String
  categoryName    String
  // Figés au moment de l'envoi : le stock fixe et le stock compté qui ont
  // produit la quantité. Un réglage ultérieur du stock fixe ne doit pas
  // réécrire l'histoire d'une commande déjà passée.
  stockFixe       Decimal    @default(0) @db.Decimal(14, 3)
  quantityOnHand  Decimal    @default(0) @db.Decimal(14, 3)
  quantityAsked   Decimal    @db.Decimal(14, 3)
  quantityServed  Decimal?   @db.Decimal(14, 3)
  /// Ce que l'employé a réellement compté à la réception. Nul tant qu'il n'a
  /// pas vérifié ; un écart avec quantityServed est conservé comme trace.
  quantityReceived Decimal?  @db.Decimal(14, 3)
  status          LineStatus @default(PENDING)
  rejectReason    String?
  sortOrder       Int        @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refills OrderRefillLine[]

  // Une ligne par article et par commande.
  @@unique([orderId, productId])
  @@index([orderId, sortOrder])
  @@index([productId])
  @@map("order_lines")
}

/// Affectation article par article.
///
/// Certaines feuilles de service ne suivent pas les catégories : la pâtisserie
/// commande le sucre glace mais pas les spaghettis, alors que les deux vivent
/// dans la même catégorie. Dès qu'un département possède au moins une ligne
/// ici, cette liste **remplace** ses catégories : sa feuille vaut exactement
/// ces articles, ni plus ni moins.
model DepartmentProduct {
  departmentId Int
  productId    Int
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([departmentId, productId])
  @@index([productId])
  @@index([departmentId, sortOrder])
  @@map("department_products")
}

/// Stock fixe : la quantité qu'un département doit détenir pour un article.
/// Réglée par l'administration ; c'est la cible dont on soustrait le stock
/// compté par l'employé pour obtenir la quantité à commander.
model StockFixe {
  departmentId Int
  productId    Int
  quantity     Decimal  @db.Decimal(14, 3)
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([departmentId, productId])
  @@index([productId])
  @@map("stock_fixe")
}

/// Compteur de tickets, un par jour et par département. Incrémenté atomiquement.
/// Arrivage : une quantité entre, avec son prix. Inventaire : à cet instant,
/// le stock vaut `quantity` au coût `unitPrice` — tout ce qui précède est
/// remplacé par ce point, et la suite se compte à partir de lui.
enum StockEntryType {
  ARRIVAGE
  INVENTAIRE
}

/// Une entrée au stock général : un arrivage, ligne par ligne, avec son prix,
/// ou un point d'inventaire. Le stock d'un article est son dernier inventaire,
/// plus les arrivages venus après, moins ce qui est parti vers les
/// départements depuis ; sa valeur suit le coût moyen ainsi obtenu.
model StockEntry {
  id          Int      @id @default(autoincrement())
  productId   Int
  type        StockEntryType @default(ARRIVAGE)
  quantity    Decimal  @db.Decimal(14, 3)
  /// Prix unitaire en dinars, tel que facturé.
  unitPrice   Decimal  @db.Decimal(14, 3)
  /// Numéro de facture ou de bon de livraison fournisseur.
  reference   String?
  note        String?
  /// Journée de service de l'arrivage.
  businessDay DateTime @db.Date
  createdById Int
  createdAt   DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy User    @relation("StockEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([productId, businessDay])
  @@index([businessDay])
  // Le stock se recalcule dans l'ordre des écritures : inventaire puis suite.
  @@index([productId, createdAt])
  @@map("stock_entries")
}

/// Une fiche technique : ce qu'un plat de la carte (ou une préparation
/// intermédiaire) consomme d'articles du stock, par portion. Importée des
/// classeurs du dossier `menu`, puis corrigée à l'écran.
model Recipe {
  id           Int        @id @default(autoincrement())
  /// Le nom tel qu'il figure sur la fiche.
  name         String
  /// Le service qui prépare : ses articles s'y consomment.
  departmentId Int
  kind         RecipeKind @default(PLAT)
  /// Le plat vendu correspondant, quand la carte le porte : c'est par lui
  /// que le Z consomme la fiche.
  salesItemId  Int?       @unique
  /// D'où vient la fiche (classeur / feuille), pour la réimporter sans doublon.
  source       String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  salesItem  SalesItem?  @relation(fields: [salesItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lines      RecipeLine[]
  usedIn     RecipeLine[] @relation("SubRecipe")

  @@unique([departmentId, name])
  @@index([departmentId, kind])
  @@map("recipes")
}

enum RecipeKind {
  /// Un plat de la carte : consommé par les ventes du Z.
  PLAT
  /// Une préparation (pâte, sauce…) : consommée par les plats qui l'utilisent.
  PREPARATION
}

/// Une ligne de fiche : un ingrédient et sa quantité par portion.
model RecipeLine {
  id          Int      @id @default(autoincrement())
  recipeId    Int
  /// Le libellé de la fiche, tel quel : c'est lui qu'on relit pour corriger.
  label       String
  quantity    Decimal  @db.Decimal(14, 4)
  /// g, kg, ml, cl, L, p (pièce), u (unité), s (sachet)… tel que la fiche l'écrit.
  unit        String
  /// L'article du stock qui s'y consomme, une fois rapproché.
  productId   Int?
  /// Ou une préparation, consommée au prorata de sa masse.
  subRecipeId Int?
  /// Coût unitaire porté par la fiche, à titre indicatif.
  cost        Decimal? @db.Decimal(14, 4)
  sortOrder   Int      @default(0)

  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subRecipe Recipe?  @relation("SubRecipe", fields: [subRecipeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([recipeId, sortOrder])
  @@index([productId])
  @@index([subRecipeId])
  @@map("recipe_lines")
}

model TicketCounter {
  businessDay  DateTime @db.Date
  departmentId Int
  lastNumber   Int      @default(0)

  @@id([businessDay, departmentId])
  @@map("ticket_counters")
}

// ─────────────────────────────────────────────────────────────
// Ventes — le Z de la caisse
// ─────────────────────────────────────────────────────────────

/// Famille de la carte de vente : Pizzas, Boissons chaudes, Desserts…
///
/// Distincte des catégories d'économat : on ne vend pas ce qu'on stocke.
/// Un café vendu consomme du café en grains, de l'eau et une tasse ; ce sont
/// deux nomenclatures, et les confondre rendrait les deux illisibles.
model SalesFamily {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SalesItem[]

  @@index([isActive, sortOrder])
  @@map("sales_families")
}

/// Un article de la carte, tel qu'il sort sur le Z de la caisse.
model SalesItem {
  id        Int      @id @default(autoincrement())
  familyId  Int
  /// Le service qui vend cet article : la cuisine sort les pizzas, le bar
  /// les cafés. Facultatif — un article peut n'être rattaché à personne.
  departmentId Int?
  name      String
  /// Code de caisse, quand il y en a un : c'est par lui que la lecture d'un
  /// Z retrouvera la ligne, le libellé pouvant varier d'un ticket à l'autre.
  code      String?
  /// Prix de vente indicatif, pour rapprocher quantités et chiffre d'affaires.
  price     Decimal? @db.Decimal(12, 3)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family     SalesFamily @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lines      SalesReportLine[]

  @@unique([familyId, name])
  @@index([isActive, sortOrder])
  @@index([code])
  @@index([departmentId])
  recipe     Recipe?
  @@map("sales_items")
}

/// Le Z d'une journée : ce qui a été vendu, article par article.
///
/// Une seule feuille par journée. Le service ferme à 3 h du matin : la
/// journée du Z se calcule donc avec ce décalage, et une saisie faite à
/// 02 h 30 appartient à la veille.
model SalesReport {
  id          Int      @id @default(autoincrement())
  /// Journée de service, à minuit UTC — clôture à 03 h locales.
  businessDay DateTime @unique @db.Date
  note        String?
  /// Nom du fichier déposé, quand le Z vient d'un PDF plutôt que de la saisie.
  sourceFile  String?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?             @relation("SalesReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lines     SalesReportLine[]

  @@index([businessDay])
  @@map("sales_reports")
}

/// Ce qu'un article a fait sur une journée.
model SalesReportLine {
  id       Int     @id @default(autoincrement())
  reportId Int
  itemId   Int
  quantity Decimal @db.Decimal(14, 3)
  /// Chiffre d'affaires de la ligne, si le Z le donne.
  amount   Decimal? @db.Decimal(14, 3)

  report SalesReport @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  item   SalesItem   @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Une ligne par article et par journée.
  @@unique([reportId, itemId])
  @@index([itemId])
  @@map("sales_report_lines")
}

/// Vente déclarée par le contrôle : ce qu'un rayon a vendu d'un article une
/// journée donnée, saisi à la main d'après le Z quand aucune fiche technique
/// ne relie l'article à la carte. S'ajoute à ce que Z × fiches calcule.
model DeclaredSale {
  id           Int      @id @default(autoincrement())
  departmentId Int
  productId    Int
  businessDay  DateTime @db.Date
  quantity     Decimal  @db.Decimal(14, 3)
  createdById  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy  User       @relation("DeclaredSaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([departmentId, productId, businessDay])
  @@index([departmentId, businessDay])
  @@map("declared_sales")
}
